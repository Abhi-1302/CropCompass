# Copy to backend/.env (never commit .env).
# Root .env and .env.local override this file; process environment variables override all files.
# Neon CLI writes the pooled DATABASE_URL and direct DATABASE_URL_UNPOOLED at the repository root.
# URLs are converted to psycopg automatically. Alembic prefers the direct URL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DBNAME?sslmode=require&channel_binding=require
DATABASE_URL=sqlite:///./dev.db

# Local http://localhost development only; keep true in any deployed environment.
COOKIE_SECURE=false

# Origins allowed to send state-changing requests (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Address of the web app, used in password-reset links.
PUBLIC_APP_URL=http://localhost:5173

# Guest creation requires migration 0007, an independently generated secret of at least 32 characters,
# and a verified proxy/client-IP configuration in production. Never use a shared example secret.
GUEST_ENABLED=false
GUEST_ABUSE_HMAC_KEY=
GUEST_PROXY_VERIFIED=false
# GUEST_RETENTION_DAYS=30
# GUEST_WARNING_DAYS=7
# GUEST_ACTIVITY_INTERVAL_SECONDS=900
# GUEST_MAX_FARMS=3
# GUEST_MAX_IDENTITIES=1000
# GUEST_CREATIONS_PER_IP_HOUR=5
# GUEST_CREATIONS_PER_IP_DAY=20
# GUEST_CREATIONS_GLOBAL_DAY=100
# GUEST_SPROUT_DAILY_REQUESTS=6
# GUEST_SPROUT_DAILY_TOKENS=40000
# GUEST_SPROUT_GLOBAL_DAILY_REQUESTS=30
# GUEST_SPROUT_GLOBAL_DAILY_TOKENS=80000
# Schedule from backend/: python -m app.guest_cleanup --execute --batch-size 100 --max-batches 20
# Without --execute this command is a counts-only dry-run. See docs/CONTINUE_AS_GUEST.md.

# Mailjet for outgoing email. All three values are required; use a verified sender address or domain.
# Credentials stay on the backend. Restart FastAPI after changing them.
# MAILJET_API_KEY=
# MAILJET_API_SECRET=
# MAILJET_FROM="CropCompass <no-reply@example.com>"
# MAILJET_HOST=in.mailjet.com
# MAILJET_PORT=2525

# Sprout is disabled until explicitly enabled with a real Groq key and migration 0006 applied.
SPROUT_ENABLED=false
GROQ_API_KEY=
SPROUT_MODEL=openai/gpt-oss-120b
# SPROUT_DAILY_REQUESTS=20
# SPROUT_GLOBAL_DAILY_REQUESTS=100
# SPROUT_DAILY_TOKENS=40000
# SPROUT_GLOBAL_DAILY_TOKENS=180000
# Enable Zero Data Retention in the Groq console. Never put this key in VITE_* variables.

# Alternative SMTP provider, used only when no Mailjet key, secret or sender is set.
# With neither provider configured and COOKIE_SECURE=false, reset links are printed in the server log.
# Incomplete Mailjet settings disable email without logging reset links, even in local development.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=CropCompass <no-reply@example.com>
# SMTP_STARTTLS=true
